const { Telegraf, Markup } = require('telegraf');
const express = require('express');

const app = express();
const BOT_TOKEN = process.env.BOT_TOKEN; // tutaweka token baadaye Render

if (!BOT_TOKEN) {
  console.log("BOT_TOKEN bado haijawekwa!");
}

const bot = new Telegraf(BOT_TOKEN);

// DATABASE YA MOVIES - Hapa ndio utaongeza movies zako
const movies = {
  "avatar": {
    title: "Avatar 2",
    seasons: {
      "1": {
        "1": "https://t.me/...",
        "2": "https://t.me/...",
      }
    },
    files: {
      "720p": "https://t.me/..."
    }
  }
};

// /start
bot.start((ctx) => {
  ctx.reply(`🔥 Karibu ROYSON MOVIE BOT 🔥\n\nTuma jina la movie:\nMf: avatar\nCommands:\n/addmovie - kuongeza movie\n/movies - orodha ya movies`,
  Markup.keyboard([['/movies', '/start']]).resize());
});

// Orodha ya movies
bot.command('movies', (ctx) => {
  const list = Object.keys(movies).map(m => `🎬 ${m} - ${movies[m].title}`).join('\n');
  ctx.reply(list || "Hakuna movie bado. Tumia /addmovie");
});

// User akituma jina la movie
bot.on('text', (ctx) => {
  const query = ctx.message.text.toLowerCase().trim();
  if (query.startsWith('/')) return;

  const movie = movies[query];
  if (!movie) {
    return ctx.reply(`❌ Movie "${query}" haijapatikana.\nJaribu: ${Object.keys(movies).join(', ')}`);
  }

  // Kama ina seasons
  if (movie.seasons) {
    const seasonButtons = Object.keys(movie.seasons).map(s =>
      Markup.button.callback(`Season ${s}`, `season_${query}_${s}`)
    );
    return ctx.reply(`🎬 ${movie.title}\nChagua Season:`, Markup.inlineKeyboard(seasonButtons, {columns: 2}));
  }

  // Kama ni movie ya kawaida
  const fileButtons = Object.keys(movie.files).map(q =>
    Markup.button.url(q, movie.files[q])
  );
  ctx.reply(`🎬 ${movie.title}\nChagua Quality:`, Markup.inlineKeyboard(fileButtons));
});

// Season button click
bot.action(/season_(.+)_(\d+)/, (ctx) => {
  const [, movieName, seasonNum] = ctx.match;
  const episodes = movies[movieName].seasons[seasonNum];
  const epButtons = Object.keys(episodes).map(ep =>
    Markup.button.url(`Episode ${ep}`, episodes[ep])
  );
  ctx.editMessageText(`🎬 ${movies[movieName].title} - Season ${seasonNum}\nChagua Episode:`, Markup.inlineKeyboard(epButtons, {columns: 2}));
  ctx.answerCbQuery();
});

bot.launch();
console.log("Royson Bot Inawaka...");

// Server ili Render isizime
app.get('/', (req, res) => res.send('Royson Movie Bot is Alive!'));
app.listen(3000, () => console.log('Server on 3000'));

process.once('SIGINT', () => bot.stop('SIGINT'));
process.once('SIGTERM', () => bot.stop('SIGTERM'));
